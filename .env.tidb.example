# ============================================================================
# SareeKart Zero-Cost TiDB Cloud Serverless Environment Variable Template
# Stage 2B-FREE Production Blueprint
#
# COPY THIS FILE TO .env.tidb AND FILL IN YOUR CLUSTER CREDENTIALS
# DO NOT COMMIT THE REAL .env.tidb FILE (PROTECTED BY .gitignore)
# ============================================================================

# 1. Spring Active Profile
SPRING_PROFILES_ACTIVE=prod
PORT=8081

# 2. TiDB Cloud Serverless Connection (MySQL 8.0 Wire-Compatible, Port 4000, TLS Enforced)
# Note: useSSL=true and allowPublicKeyRetrieval=true are mandatory for TiDB Cloud Serverless TLS handshake
SPRING_DATASOURCE_URL=jdbc:mysql://<tidb_host>:4000/<tidb_db>?useSSL=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=<tidb_user>
SPRING_DATASOURCE_PASSWORD=<tidb_pass>

# 3. Connection Pool Discipline (Optimized for Free Tier TiDB Serverless & 512MB RAM Container)
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

# 4. Hibernate DDL Safety Gate (Zero schema mutation in production)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# 5. Flyway Clean-Room Migration Settings (Empty DB -> V1 -> V17..V32)
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false

# 6. Neo4j Zero-Cost Fallback Circuit Breaker (Zero-cost MySQL fallback hydration)
NEO4J_ENABLED=false

# 7. JWT Authentication Security (Minimum 64 characters)
JWT_SECRET=SareeKartSecretKey2024ForJWTTokenGenerationAndValidationWithMinimumSixtyFourCharacters
JWT_EXPIRATION=86400000

# 8. CORS Allowed Origins (Production apex + Vercel edge preview domains)
CORS_ALLOWED_ORIGINS=https://sareekart.com,https://*.vercel.app

# 9. Strict 512MB RAM Container Memory Discipline
JAVA_TOOL_OPTIONS=-Xmx384m -Xms128m -XX:+UseSerialGC -XX:TieredStopAtLevel=1

# 10. Frontend Edge API Integration
VITE_API_BASE_URL=https://sareekart-api.onrender.com/api
