# ====================================================================
# SareeKart Production Environment Configuration Template
# ====================================================================
# Set these environment variables in your Vercel Project Settings:
# Settings -> Environment Variables -> Production
# ====================================================================

# Public HTTPS Backend URL
# Points to your free-tier containerized Spring Boot backend (Render/Koyeb).
# Note: SareeKart's axiosConfig automatically ensures the '/api' prefix is preserved.
VITE_API_BASE_URL=https://sareekart-backend.onrender.com/api

# WebSocket Endpoint for Real-time Notifications & Admin Live Telemetry (Optional)
VITE_WS_URL=https://sareekart-backend.onrender.com/ws-sareekart

# Canonical Domain for SEO Canonical Link and OpenGraph Tags
VITE_CANONICAL_DOMAIN=https://sareekart.com

# Optional Third-Party Services
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GSC_VERIFICATION=google-site-verification-...
