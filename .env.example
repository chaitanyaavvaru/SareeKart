# ============================================================================
# SareeKart Enterprise Production Environment Variable Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL PRODUCTION SECRETS
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# ============================================================================

# 1. Spring Profile
SPRING_PROFILES_ACTIVE=prod
PORT=8081

# 2. Production Database (MySQL 8.0)
SPRING_DATASOURCE_URL=jdbc:mysql://<db-host>:3306/sareekart_db?createDatabaseIfNotExist=false&useSSL=true&requireSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<secure-db-password>
HIKARI_MAX_POOL_SIZE=25
HIKARI_MIN_IDLE=10

# 3. JWT Authentication Security
# Generate via: openssl rand -base64 64
JWT_SECRET=<64-char-minimum-base64-random-secret>
JWT_EXPIRATION=86400000

# 4. CORS Whitelist
# Comma-separated list of allowed production domains
CORS_ALLOWED_ORIGINS=https://sareekart.com,https://www.sareekart.com

# 5. Payment Gateway (Razorpay Production API Keys)
RAZORPAY_KEY_ID=rzp_live_<key-id>
RAZORPAY_KEY_SECRET=<live-key-secret>
RAZORPAY_WEBHOOK_SECRET=<live-webhook-secret>

# 6. Meta WhatsApp Cloud API (v19.0)
WHATSAPP_API_TOKEN=<system-user-access-token>
WHATSAPP_PHONE_NUMBER_ID=<meta-phone-number-id>
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<custom-random-verify-token>
WHATSAPP_APP_SECRET=<meta-app-secret-for-hmac-sha256>

# 7. Generative AI (Spring AI / OpenAI / Gemini API)
OPENAI_API_KEY=sk-proj-<live-openai-or-gemini-key>

# 8. Neo4j Knowledge Graph (Bolt Protocol)
NEO4J_URI=bolt://<neo4j-host>:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<secure-neo4j-password>
NEO4J_ENABLED=true

# 9. Logging Levels
LOG_LEVEL_SAREEKART=INFO
LOG_LEVEL_SPRING_WEB=WARN
LOG_LEVEL_HIBERNATE_SQL=WARN

# 10. Frontend Marketing, Analytics & Search Console (Vite)
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=123456789012345
VITE_GSC_VERIFICATION=google-site-verification-token
