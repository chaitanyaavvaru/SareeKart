# Copy to .env and fill in before running `docker compose up`.
# Never commit the real .env file.

# MySQL root password used by the stack database
DB_PASSWORD=sareekart123

# Host port for MySQL debugging access (3307 avoids clashes with a local mysqld)
MYSQL_HOST_PORT=3307

# Browser-facing port for the storefront
FRONTEND_HOST_PORT=5173

# Generate with: openssl rand -base64 64
# MUST be >= 64 bytes; the backend refuses to start otherwise (HS512 requirement).
JWT_SECRET=Zk9xV3bQ7mR2sY8wJ5hL4dN1pC6tG0fK9uE3rB7vX2zM5aS8qW4jH7nD2gT6yU1oP3iF9kR5sB8vM4cX

# Set false in production once real accounts exist (disables demo login seeding)
APP_SEED_ENABLED=true

# Razorpay configuration (test mode credentials from Razorpay Dashboard)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# Set to 'false' to disable Razorpay (COD-only mode)
APP_RAZORPAY_ENABLED=true
# Abandoned-checkout sweeper (online orders PENDING longer than N minutes expire)
APP_SWEEPER_ENABLED=true
APP_SWEEPER_STALE_MINUTES=30

# Refund reconciliation (polls gateway for refunds stuck PENDING past N minutes)
APP_REFUND_RECONCILIATION_ENABLED=true
APP_REFUND_RECONCILIATION_STALE_MINUTES=15

# File storage: 'local' for dev, 's3' for production
APP_STORAGE_PROVIDER=local
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CDN_BASE_URL=
